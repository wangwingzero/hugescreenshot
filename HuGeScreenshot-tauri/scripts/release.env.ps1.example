# -----------------------------------------------------------------------------
# HuGeScreenshot 发布凭证模板
# -----------------------------------------------------------------------------
# 使用方法:
#   1. 复制为 scripts/release.env.ps1 或把对应变量写入仓库根目录 .env
#   2. 填入你自己的发布服务器/对象存储凭证
#   3. 运行 npm run release:server 或 npm run release:r2
#
# 注意:
#   - 不要提交真实凭证文件
#   - TAURI_PRIVATE_KEY/TAURI_SIGNING_PRIVATE_KEY 由你在本地自行配置
# -----------------------------------------------------------------------------

# [必填] 发布服务器 SSH 私钥路径
RELEASE_SSH_KEY=C:\Users\you\.ssh\your_server_id_ed25519

# [必填] 发布服务器连接参数
RELEASE_SSH_HOST=your-server.example.com
RELEASE_SSH_USER=root
RELEASE_SSH_PORT=22
RELEASE_REMOTE_DIR=/var/www/hugescreenshot

# [必填] 最终对外可访问的更新域名
HUGESCREENSHOT_RELEASE_BASE_URL=https://downloads.example.com
HUGESCREENSHOT_CF_UPDATE_BASE_URL=https://downloads.example.com

# [可选] Cloudflare purge 凭证（用于发布后清缓存）
# 推荐创建专用 Token，且只授予需要的 Zone 与 Cache Purge 权限。
HUGESCREENSHOT_CF_ZONE_ID=your_cloudflare_zone_id
HUGESCREENSHOT_CF_API_TOKEN=your_scoped_cloudflare_api_token

# [可选] R2 发布凭证
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_BUCKET=your-bucket
# R2_PUBLIC_URL=https://downloads.example.com
